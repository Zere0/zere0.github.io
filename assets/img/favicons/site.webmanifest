---
layout: compress
---

{% comment %} Same file as the theme's, with the site's own colours (the theme ships purple on white). {% endcomment %}
{% assign favicon_path = "/assets/img/favicons" | relative_url %}

{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description }}",
  "icons": [
    {
      "src": "{{ favicon_path }}/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ favicon_path }}/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "start_url": "{{ '/index.html' | relative_url }}",
  "theme_color": "#1b1b1e",
  "background_color": "#1b1b1e",
  "display": "standalone"
}
